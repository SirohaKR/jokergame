  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid",
        "description": "HttpOnly, Secure, SameSite=Lax 세션 쿠키. 인증 API/공급자는 미정."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "mode",
          "version",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "local-ai"
            ]
          },
          "version": {
            "type": "string"
          },
          "database": {
            "type": "string",
            "enum": [
              "not-connected"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "nickname",
          "coins",
          "rankPoints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "coins": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rankPoints": {
            "type": "integer",
            "minimum": 0
          },
          "selectedCharacterId": {
            "type": "string"
          }
        }
      },
      "Character": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "standingAsset"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "standingAsset": {
            "type": "string"
          },
          "affinity": {
            "type": "integer",
            "minimum": 0
          },
          "ownedCosmeticIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "selectedCharacterId": {
            "type": "string"
          },
          "bgmVolume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "sfxVolume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "turnSound": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateMatch": {
        "type": "object",
        "required": [
          "characterId",
          "plannedSets"
        ],
        "properties": {
          "characterId": {
            "type": "string"
          },
          "plannedSets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "mode": {
            "type": "string",
            "enum": [
              "private"
            ]
          }
        },
        "additionalProperties": false
      },
      "Match": {
        "type": "object",
        "required": [
          "id",
          "status",
          "plannedSets",
          "players"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "inviteCode": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "lobby",
              "playing",
              "finished",
              "cancelled"
            ]
          },
          "plannedSets": {
            "type": "integer"
          },
          "players": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "seat",
                "nickname",
                "characterId",
                "isBot"
              ],
              "properties": {
                "seat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "nickname": {
                  "type": "string"
                },
                "characterId": {
                  "type": "string"
                },
                "isBot": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "rank",
          "suit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 13
          },
          "suit": {
            "type": "string",
            "enum": [
              "♠",
              "♥",
              "♦",
              "♣",
              "★"
            ]
          }
        }
      },
      "PlayerView": {
        "type": "object",
        "required": [
          "seat",
          "handCount"
        ],
        "properties": {
          "seat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "handCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 53
          },
          "ownHand": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "description": "요청자 본인에게만 제공. 다른 좌석에는 필드 자체를 생략."
          },
          "finishOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "setId",
          "revision",
          "phase",
          "actorSeat",
          "players"
        ],
        "properties": {
          "setId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "phase": {
            "type": "string",
            "enum": [
              "action",
              "select",
              "reveal",
              "discard",
              "ended"
            ]
          },
          "actorSeat": {
            "type": "integer"
          },
          "phaseDeadline": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerView"
            }
          },
          "privateDrawResult": {
            "type": "object",
            "description": "당사자 둘만 제공. 관전자/대기자에게 생략.",
            "properties": {
              "card": {
                "$ref": "#/components/schemas/Card"
              },
              "sourceSeat": {
                "type": "integer"
              },
              "actorSeat": {
                "type": "integer"
              }
            }
          }
        }
      },
      "SetResult": {
        "type": "object",
        "required": [
          "setNo",
          "players"
        ],
        "properties": {
          "setNo": {
            "type": "integer"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "seat",
                "finishOrder",
                "winner",
                "score"
              ],
              "properties": {
                "seat": {
                  "type": "integer"
                },
                "finishOrder": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "winner": {
                  "type": "boolean"
                },
                "score": {
                  "type": "integer",
                  "enum": [
                    1000,
                    500,
                    0,
                    -500
                  ]
                }
              }
            }
          }
        }
      },
      "MatchResult": {
        "type": "object",
        "properties": {
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetResult"
            }
          },
          "rankings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seat": {
                  "type": "integer"
                },
                "place": {
                  "type": "integer"
                },
                "totalScore": {
                  "type": "integer"
                },
                "coinsDelta": {
                  "type": "integer"
                },
                "rankDelta": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "GiftRequest": {
        "type": "object",
        "required": [
          "characterId",
          "productId"
        ],
        "properties": {
          "characterId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PurchaseResult": {
        "type": "object",
        "required": [
          "coins",
          "affinity"
        ],
        "properties": {
          "coins": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "affinity": {
            "type": "integer",
            "minimum": 0
          },
          "unlockedIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}